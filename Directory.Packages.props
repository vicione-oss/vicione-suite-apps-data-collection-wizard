<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ViciOneSuiteSdkVersion>3.2.0</ViciOneSuiteSdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="ViciOne.CodeAnalysis" Version="1.6.0" />
    <PackageVersion Include="AspNetCore.SassCompiler" Version="1.105.1" />
    <PackageVersion Include="FastDeepCloner" Version="1.3.6" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Semver" Version="3.0.0" />
    <PackageVersion Include="ViciOne.Core.Dataflow.DataModel.Generation" Version="1.0.0" />
    <PackageVersion Include="ViciOne.Cluster.Builder" Version="1.0.0" />
    <PackageVersion Include="ViciOne.DeviceTree.Contracts" Version="2.1.0" />
    <PackageVersion Include="ViciOne.Suite.ClusterManagement.Public" Version="2.4.0-ci2729942661" />
    <PackageVersion Include="ViciOne.Suite.Sdk" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Backend" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Deployment" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Client" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Ui.Blazor.Components" Version="6.2.0" />
    <PackageVersion Include="ViciOne.Ui.MonochromeIcons.Components" Version="4.18.0" />
    <PackageVersion Include="ViciOne.Ui.Design" Version="2.5.0" />
    <PackageVersion Include="ViciOne.Ui.TreeEditor" Version="2.0.1" />
    <!--Used for tests only:-->
    <PackageVersion Include="ViciOne.Suite.Sdk.Testing" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Extensions.Logging.NSubstitute" Version="1.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>
</Project>
