<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ViciOneSuiteSdkVersion>1.1.0</ViciOneSuiteSdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="ViciOne.CodeAnalysis" Version="1.2.1" />
    <PackageVersion Include="AspNetCore.SassCompiler" Version="1.94.2" />
    <PackageVersion Include="FastDeepCloner" Version="1.3.6" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7" />
    <PackageVersion Include="ViciOne.Core.Dataflow.DataModel.Generation" Version="0.51.0" />
    <PackageVersion Include="ViciOne.Cluster.Builder" Version="0.11.0" />
    <PackageVersion Include="ViciOne.Driver.IoTCore.Contracts" Version="1.21.0" />
    <PackageVersion Include="ViciOne.Suite.ClusterManagement.Public" Version="1.3.0" />
    <PackageVersion Include="ViciOne.Suite.DataPort.Anna.Contracts" Version="0.38.0" />
    <PackageVersion Include="ViciOne.Suite.Sdk" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Backend" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Deployment" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Client" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Ui.Blazor.Components" Version="4.2.0" />
    <PackageVersion Include="ViciOne.Ui.MonochromeIcons.Assets" Version="3.10.0" />
    <PackageVersion Include="ViciOne.Ui.Shared.Dx" Version="0.16.2" />
    <PackageVersion Include="ViciOne.Ui.TreeEditor" Version="0.12.0" />
    <!--Used for tests only:-->
    <PackageVersion Include="ViciOne.Suite.Sdk.Testing" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Extensions.Logging.NSubstitute" Version="1.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.abstractions" Version="2.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
