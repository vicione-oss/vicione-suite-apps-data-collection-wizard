<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ViciOneSuiteSdkVersion>2.0.0-ci2397913518</ViciOneSuiteSdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="ViciOne.CodeAnalysis" Version="1.2.1" />
    <PackageVersion Include="AspNetCore.SassCompiler" Version="1.97.1" />
    <PackageVersion Include="FastDeepCloner" Version="1.3.6" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
    <PackageVersion Include="Semver" Version="3.0.0" />
    <PackageVersion Include="ViciOne.Core.Dataflow.DataModel.Generation" Version="0.51.0" />
    <PackageVersion Include="ViciOne.Cluster.Builder" Version="0.11.0" />
    <PackageVersion Include="ViciOne.Driver.IoTCore.Contracts" Version="2.0.0-ci2336879852" />
    <PackageVersion Include="ViciOne.Suite.ClusterManagement.Public" Version="2.0.0-ci2381022984" />
    <PackageVersion Include="ViciOne.Suite.DataPort.Anna.Contracts" Version="0.38.0" />
    <PackageVersion Include="ViciOne.Suite.Sdk" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Backend" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Deployment" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Client" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Ui.Blazor.Components" Version="5.5.0" />
    <PackageVersion Include="ViciOne.Ui.MonochromeIcons.Assets" Version="4.4.0" />
    <PackageVersion Include="ViciOne.Ui.Design" Version="2.0.3" />
    <PackageVersion Include="ViciOne.Ui.Shared.Dx" Version="0.19.1" />
    <PackageVersion Include="ViciOne.Ui.TreeEditor" Version="2.0.0" />
    <!--Used for tests only:-->
    <PackageVersion Include="ViciOne.Suite.Sdk.Testing" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Extensions.Logging.NSubstitute" Version="1.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
