        CssClass="dcw-dialog-top"
        HeaderText="@Localization.DataCollectionWizardPage.DeleteDialogHeader"
        Height="300px"
        Width="600px">

    <Body>
        <DialogBodyTextLayout>
            <p class="dialog-content text-only">@Localization.DataCollectionWizardPage.DeleteDialogText</p>
        </DialogBodyTextLayout>
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@OnDeleteDialogOkAsync"
                            Text="@CommonVocabulary.Ok" />

        <DialogFooterButton OnClick="@OnDeleteDialogCloseAsync"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>

