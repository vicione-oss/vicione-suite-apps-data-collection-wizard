        HeaderText="@Localization.DataCollectionWizardPage.ClusterOutOfDateDialogHeader"
        Height="350px"
        Width="600px">

    <Body>
        <DialogBodyTextLayout>
            <p class="dialog-content text-only">@Localization.DataCollectionWizardPage.ClusterOutOfDateDialogText</p>
        </DialogBodyTextLayout>
