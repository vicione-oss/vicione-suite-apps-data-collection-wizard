@* CloseOnEscape="true" not supported yet, https://gitlab.com/vicione-oss/vicione/ui-libs/blazor-components/-/issues/141 *@
<Dialog @ref="@_refAddVSEDialog"
        CssClass="dcw-dialog-top"
        HeaderText="@Localization.DataCollectionWizardPage.AddVseDialogHeader"
        Height="@_vseDialogHeight"
        OnClosing="ResetAddVSEDialog"
        VisibleChanged="OnAddVSEDialogVisibleChangedAsync"
        Width="600px">

    <Body>
        <div class="dialog-content dialog-content-vse">
            <div class="toolbar-container">
                <div class="tab-control-container">
                    <TabStrip @bind-ActiveTabIndex="_vseTabIndex" TabSize="TabSize.Large">
                        <Tab Text="@Localization.DataCollectionWizardPage.Manual" OnSelected="@((i) => SetVseDialogScanHeight(i.TabIndex))" />
                        <Tab Text="@Localization.DataCollectionWizardPage.Scan" OnSelected="@((i) => SetVseDialogScanHeight(i.TabIndex))" />
                    </TabStrip>
                </div>

                @if (_vseTabIndex == 1)
                {
                    <DeviceScanToolbar @bind-Filter="@_vseFilter"
                                       OnRescan="@OnRescanVseDevicesClicked"
                                       RescanTitle="@Localization.DataCollectionWizardPage.Rescan" />
                }
            </div>

            <div class="content-container">
                @if (_vseTabIndex == 0)
                {
                    <div class="dialog-card">
                        <div class="dialog-card-head">
                            <span class="dialog-card-icon">
                                <MonochromeIcon Name="@MonochromeIconName.Connectivity" Size="@MonochromeIconSize.Small" />
                            </span>
                            <div class="dialog-card-heading">
                                <span class="dialog-card-title">@Localization.DataCollectionWizardPage.IoLinkMasterConnection</span>
                                <span class="dialog-card-subtitle">@Localization.DataCollectionWizardPage.VseConnectionHint</span>
                            </div>
                        </div>

                        <div class="dialog-fields">
                            <div class="dialog-field">
                                <span class="dialog-field-label">@Localization.DataCollectionWizardPage.VseAddress</span>
                                <TextBox Value="@_newVSEAddress"
                                         ValueChanging="OnAddVSEAddressChanged"
                                         @ref="_refAddVSETextBox"
                                         Placeholder="@Localization.DataCollectionWizardPage.VseAddressExample"
                                         EnterPressed="OnAddVSETextBoxEnterPressedAsync" />

                                <div class="validation-message-container">
                                    @if (!_isVSEUriValid)
                                    {
                                        <span class="validation-message">
                                            @Localization.DataCollectionWizardPage.InvalidDeviceAddress
                                        </span>
                                    }

                                    @if (!_isVSEUriUnique)
                                    {
                                        <span class="validation-message">
                                            @Localization.DataCollectionWizardPage.DeviceAddressNotUnique
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <DeviceScanList TDevice="VseScanDevice"
                                    Devices="@_scannedVseDevices"
                                    Errors="@_scanVseErrors"
                                    Filter="@_vseFilter"
                                    MatchesFilter="@MatchesVseFilter"
                                    IsSelected="@(d => _selectedVseDevices.Contains(d.IpAddress))"
                                    SelectionChanged="@(s => OnScannedVseDeviceSelectionChanged(s.Selected, s.Device))"
                                    SpinnerMessages="@(_loadingSpinnerMessagesNetworkScan)"
                                    ScanErrorText="@Localization.DataCollectionWizardPage.DeviceScanError"
                                    NoResultText="@Localization.DataCollectionWizardPage.DeviceScanNoResult"
                                    FilterNoResultText="@Localization.DataCollectionWizardPage.DeviceScanFilterNoResult">
                        <DeviceTemplate>
                            <div class="device-list-entry-name">
                                @(string.IsNullOrWhiteSpace(context.HostName) ? context.DeviceType : context.HostName)
                            </div>

                            <div class="device-list-entry-info">
                                @($"{context.IpAddress}:{context.Port} | {context.MacAddress} | {context.DeviceType}")
                            </div>
                        </DeviceTemplate>
                    </DeviceScanList>
                }
            </div>
        </div>
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@OnAddVSEDialogOkAsync"
                            Text="@CommonVocabulary.Ok"
                            Enabled="@IsVseDialogOkEnabled()" />

        <DialogFooterButton OnClick="@OnAddVSEDialogCloseAsync"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>

@if (_showUnsavedChanges)
{
    <div class="unsaved-backdrop" @onclick="@(() => ResolveUnsavedLeave(UnsavedLeaveChoice.Cancel))">
        <div class="unsaved-card" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="unsaved-body">
                <span class="unsaved-icon">
                    <MonochromeIcon Name="@MonochromeIconName.WarningLight" Size="@MonochromeIconSize.SmallMedium" />
                </span>
                <div class="unsaved-text">
                    <div class="unsaved-title">@Localization.DataCollectionWizardPage.UnsavedChangesTitle</div>
                    <div class="unsaved-message">@Localization.DataCollectionWizardPage.UnsavedChangesPrompt</div>
                </div>
            </div>

            <div class="unsaved-footer">
                <button class="unsaved-btn ghost" @onclick="@(() => ResolveUnsavedLeave(UnsavedLeaveChoice.Cancel))">
                    @CommonVocabulary.Cancel
                </button>
                <span class="unsaved-grow"></span>
                <button class="unsaved-btn danger" @onclick="@(() => ResolveUnsavedLeave(UnsavedLeaveChoice.Discard))">
                    @Localization.DataCollectionWizardPage.Discard
                </button>
                <button class="unsaved-btn primary" @onclick="@(() => ResolveUnsavedLeave(UnsavedLeaveChoice.Save))">
                    @CommonVocabulary.Save
                </button>
            </div>
        </div>
    </div>
}

@* CloseOnEscape="true" not supported yet, https://gitlab.com/vicione-oss/vicione/ui-libs/blazor-components/-/issues/141 *@
<Dialog @ref="@_refAddIoLinkMasterDialog"
        CssClass="dcw-dialog-top"
        HeaderText="@Localization.DataCollectionWizardPage.AddIoLinkMasterDialogHeader"
        Height="@_ioLinkMasterDialogHeight"
        OnClosing="ResetAddIoLinkMasterDialog"
        VisibleChanged="OnAddIoLinkMasterDialogVisibleChangedAsync"
        Width="600px">

    <Body>
        <div class="dialog-content dialog-content-iolink">
            @if (_ioLinkShowCredentialStep)
            {
                <div class="content-container">
                    @{
                        var credentialAddresses = SelectedAuthRequiredAddresses();
                    }

                    <div class="dialog-card credential-step">
                        <div class="dialog-card-head">
                            <span class="dialog-card-icon">
                                <MonochromeIcon Name="@MonochromeIconName.LockActive" Size="@MonochromeIconSize.Small" />
                            </span>
                            <div class="dialog-card-heading">
                                <span class="dialog-card-title">@Localization.DataCollectionWizardPage.IoLinkMasterAuthentication</span>
                                <span class="dialog-card-subtitle">@Localization.DataCollectionWizardPage.IoLinkCredentialStepHint</span>
                            </div>

                            @if (credentialAddresses.Count > 1)
                            {
                                <label class="dialog-card-shared">
                                    <input type="checkbox"
                                           checked="@_ioLinkUseSharedCredentials"
                                           @onchange="@(e => OnUseSharedCredentialsChanged((bool)e.Value!, credentialAddresses))" />
                                    @Localization.DataCollectionWizardPage.IoLinkUseSameCredentialsForAll
                                </label>
                            }
                        </div>

                        <div class="credential-step-list">
                            @if (_ioLinkUseSharedCredentials && credentialAddresses.Count > 1)
                            {
                                <div class="credentials-master">
                                    <div class="credentials-master-fields">
                                        <TextBox Value="@_ioLinkSharedUser"
                                                 ValueChanging="@(value => _ioLinkSharedUser = value)"
                                                 Placeholder="@Localization.DataCollectionWizardPage.IoLinkMasterUsername" />
                                        <TextBox Value="@_ioLinkSharedPassword"
                                                 ValueChanging="@(value => _ioLinkSharedPassword = value)"
                                                 Password="true"
                                                 Placeholder="@Localization.DataCollectionWizardPage.IoLinkMasterPassword" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                @foreach (var authAddress in credentialAddresses)
                                {
                                    <div class="credentials-master">
                                        <span class="credentials-master-name"><span class="credentials-master-ip">@DeviceIpForAddress(authAddress)</span>@DeviceNameForAddress(authAddress)</span>
                                        <div class="credentials-master-fields">
                                            <TextBox Value="@GetIoLinkCredentialUser(authAddress)"
                                                     ValueChanging="@(value => SetIoLinkCredentialUser(authAddress, value))"
                                                     Placeholder="@Localization.DataCollectionWizardPage.IoLinkMasterUsername" />
                                            <TextBox Value="@GetIoLinkCredentialPassword(authAddress)"
                                                     ValueChanging="@(value => SetIoLinkCredentialPassword(authAddress, value))"
                                                     Password="true"
                                                     Placeholder="@Localization.DataCollectionWizardPage.IoLinkMasterPassword" />
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
            <div class="toolbar-container">
                <div class="tab-control-container">
                    <TabStrip @bind-ActiveTabIndex="_ioLinkMasterTabIndex" TabSize="TabSize.Large">
                        <Tab Text="@Localization.DataCollectionWizardPage.Manual" OnSelected="@((i) => SetIoLinkMasterDialogScanHeight(i.TabIndex))" />
                        <Tab Text="@Localization.DataCollectionWizardPage.Scan" OnSelected="@((i) => SetIoLinkMasterDialogScanHeight(i.TabIndex))" />
                    </TabStrip>
                </div>

                @if (_ioLinkMasterTabIndex == 1)
                {
                    <DeviceScanToolbar @bind-Filter="@_ioLinkMasterFilter"
                                       OnRescan="@OnRescanIoLinkDevicesClicked"
                                       RescanTitle="@Localization.DataCollectionWizardPage.Rescan" />
                }
            </div>

            <div class="content-container">
                @if (_ioLinkMasterTabIndex == 0)
                {
                    <div class="dialog-card">
                        <div class="dialog-card-head">
                            <span class="dialog-card-icon">
                                <MonochromeIcon Name="@MonochromeIconName.Connectivity" Size="@MonochromeIconSize.Small" />
                            </span>
                            <div class="dialog-card-heading">
                                <span class="dialog-card-title">@Localization.DataCollectionWizardPage.IoLinkMasterConnection</span>
                                <span class="dialog-card-subtitle">@Localization.DataCollectionWizardPage.IoLinkMasterConnectionHint</span>
                            </div>
                        </div>

                        <div class="dialog-fields">
                            <div class="dialog-field">
                                <span class="dialog-field-label">@Localization.DataCollectionWizardPage.IoLinkMasterAddress</span>
                                <TextBox Value="@_newIoLinkMasterAddress"
                                         ValueChanging="OnAddIoLinkMasterAddressChanged"
                                         @ref="_refAddIoLinkMasterTextBox"
                                         Placeholder="@Localization.DataCollectionWizardPage.IoLinkMasterAddressExample"
                                         EnterPressed="OnAddIoLinkMasterTextBoxEnterPressedAsync" />

                                <div class="validation-message-container">
                                    @if (!_isIoLinkMasterUriValid)
                                    {
                                        <span class="validation-message">
                                            @Localization.DataCollectionWizardPage.InvalidDeviceAddress
                                        </span>
                                    }

                                    @if (!_isIoLinkMasterUriUnique)
                                    {
                                        <span class="validation-message">
                                            @Localization.DataCollectionWizardPage.DeviceAddressNotUnique
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="dialog-card">
                        <div class="dialog-card-head">
                            <span class="dialog-card-icon">
                                <MonochromeIcon Name="@MonochromeIconName.LockActive" Size="@MonochromeIconSize.Small" />
                            </span>
                            <div class="dialog-card-heading">
                                <span class="dialog-card-title">@Localization.DataCollectionWizardPage.IoLinkMasterAuthentication</span>
                                <span class="dialog-card-subtitle">@Localization.DataCollectionWizardPage.IoLinkMasterCredentialsHint</span>
                            </div>
                        </div>

                        <div class="dialog-fields dialog-fields-two">
                            <div class="dialog-field">
                                <span class="dialog-field-label">@Localization.DataCollectionWizardPage.IoLinkMasterUsername</span>
                                <TextBox Value="@_newIoLinkMasterUser" ValueChanging="@(value => _newIoLinkMasterUser = value)" Placeholder="@Localization.DataCollectionWizardPage.IoLinkMasterUsername" />
                            </div>

                            <div class="dialog-field">
                                <span class="dialog-field-label">@Localization.DataCollectionWizardPage.IoLinkMasterPassword</span>
                                <TextBox Value="@_newIoLinkMasterPassword" ValueChanging="@(value => _newIoLinkMasterPassword = value)" Password="true" Placeholder="@Localization.DataCollectionWizardPage.IoLinkMasterPassword" />
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <DeviceScanList TDevice="DcpDevice"
                                    Devices="@_scannedIoLinkDevices"
                                    Errors="@_scanIoLinkErrors"
                                    Filter="@_ioLinkMasterFilter"
                                    MatchesFilter="@MatchesIoLinkFilter"
                                    IsSelected="@(d => _selectedIoLinkDevices.Contains(d.Network.Address!.ToString()))"
                                    SelectionChanged="@(s => OnScannedDeviceSelectionChanged(s.Selected, s.Device))"
                                    SpinnerMessages="@(_loadingSpinnerMessagesNetworkScan)"
                                    ScanErrorText="@Localization.DataCollectionWizardPage.DeviceScanError"
                                    NoResultText="@Localization.DataCollectionWizardPage.DeviceScanNoResult"
                                    FilterNoResultText="@Localization.DataCollectionWizardPage.DeviceScanFilterNoResult">
                        <DeviceTemplate>
                            <div class="device-list-entry-name">
                                @context.Identity.Name
                                @if (context.Security.RequiresAuthentication)
                                {
                                    <span class="device-auth-lock" title="@Localization.DataCollectionWizardPage.DeviceScanRequiresAuthentication">
                                        <MonochromeIcon Name="@MonochromeIconName.LockActive" Size="@MonochromeIconSize.Small" />
                                    </span>
                                    <span class="device-auth-badge">Auth</span>
                                }
                            </div>

                            <div class="device-list-entry-info">
                                @($"{context.Network.Address!.DnsSafeHost}:{context.Network.Address.Port} | {context.Network.MacAddress} | {context.Identity.VendorId}-{context.Identity.DeviceId}")
                            </div>
                        </DeviceTemplate>
                    </DeviceScanList>
                }
            </div>
            }
        </div>
    </Body>

    <Footer>
        @if (_ioLinkShowCredentialStep)
        {
            <DialogFooterButton OnClick="@OnAddIoLinkMasterDialogOkAsync"
                                Enabled="@IsIoLinkMasterDialogOkEnabled()"
                                Text="@CommonVocabulary.Add" />

            <DialogFooterButton OnClick="@BackToIoLinkSelection"
                                Text="@CommonVocabulary.BackVerb" />
        }
        else if (IoLinkScanNeedsCredentialStep())
        {
            <DialogFooterButton OnClick="@GoToIoLinkCredentialStep"
                                Enabled="true"
                                Text="@Localization.DataCollectionWizardPage.WizardNext" />

            <DialogFooterButton OnClick="@OnAddIoLinkMasterDialogCloseAsync"
                                Text="@CommonVocabulary.Cancel" />
        }
        else
        {
            <DialogFooterButton OnClick="@OnAddIoLinkMasterDialogOkAsync"
                                Enabled="@IsIoLinkMasterDialogOkEnabled()"
                                Text="@CommonVocabulary.Ok" />

            <DialogFooterButton OnClick="@OnAddIoLinkMasterDialogCloseAsync"
                                Text="@CommonVocabulary.Cancel" />
        }
    </Footer>
</Dialog>
