@using ViciOne.Ui.Blazor.Components.ExpandableMenu.Components
@using ViciOne.Ui.Blazor.Components.ExpandableMenu.Models
@using ViciOne.Ui.Blazor.Components.Sidebar
@using ViciOne.Ui.Blazor.Components.Sidebar.Enums

<div class="resizable-sidebar-host @(_compactMode ? "compact" : string.Empty)" @ref="_hostRef">
    <Sidebar @bind-FluidWidth="_sidebarFluidWidth"
             CompactWidth="56"
             FluidMinimumWidth="@FluidMinimumWidth"
             FluidMaximumWidth="@FluidMaximumWidth"
             Mode="@(_compactMode ? SidebarMode.Compact : SidebarMode.Fluid)"
             Placement="SidebarPlacement.Left">

        <ExpandableMenu @bind-CompactMode="_compactMode"
                        Entries="@Entries" />
    </Sidebar>

    @* Own resize grip: replaces the house Sidebar's built-in mover (which loses the pointer and re-renders per
       move). The drag is driven entirely in JS with pointer capture; see ResizableSidebar.razor.js. *@
    <div class="resizable-sidebar-handle" @ref="_handleRef"></div>
</div>
