@using DataCollectionWizard.Client.Components.Localization
@using DataCollectionWizard.Client.Models

@{
    var deviceInfo = GetDeviceInfo();
    var hasInfo = deviceInfo.Count > 0;

    var hasImage = !string.IsNullOrWhiteSpace(_deviceImageDataBase64);
    var nodeStatus = Device.GetStatus(IsLiveView);
    var inheritedStatus = (NodeStatus)InheritedStatus & ~nodeStatus;
    var hasInheritedStatus = inheritedStatus != NodeStatus.None;
}

<div class="tooltip-container @(hasImage ? string.Empty : "no-image") @(hasInfo ? string.Empty : "no-info") @(nodeStatus == NodeStatus.None && !hasInheritedStatus ? "no-status" : string.Empty)">
    <div class="tooltip-header">
        @(Device.Name)
    </div>

    @if (hasInfo)
    {
        <div class="device-info">
            @foreach (var info in deviceInfo)
            {
                if (info.Key == DeviceInfoSeparatorKey)
                {
                    <div class="separator"></div>
                }
                else
                {
                    <label>@(info.Key)</label>
                    <span>@(info.Value)</span>
                }
            }
        </div>
    }

    @if (hasImage)
    {
        <div class="device-image">
            <img src="data:image/jpeg;base64,@(_deviceImageDataBase64)" />
        </div>
    }

    @if (nodeStatus != NodeStatus.None || hasInheritedStatus)
    {
        <div class="device-status">
            @if (nodeStatus.HasFlag(NodeStatus.Offline))
            {
                <div class="status error">
                    <div class="status-dot"></div>
                    <span>@(DeviceTreeTooltip.DeviceStatusOffline)</span>
                </div>
            }

            @if (nodeStatus.HasFlag(NodeStatus.NotSupported))
            {
                <div class="status warning">
                    <div class="status-dot"></div>
                    <span>@(DeviceTreeTooltip.DeviceStatusNotSupported)</span>
                </div>
            }

            @if (nodeStatus.HasFlag(NodeStatus.Unknown))
            {
                <div class="status warning">
                    <div class="status-dot"></div>
                    <span>@(DeviceTreeTooltip.DeviceStatusUnknown)</span>
                </div>
            }

            @if (nodeStatus.HasFlag(NodeStatus.New))
            {
                <div class="status info">
                    <div class="status-dot"></div>
                    <span>@(DeviceTreeTooltip.DeviceStatusNewlyCreated)</span>
                </div>
            }

            @if (hasInheritedStatus)
            {
                @if (inheritedStatus.HasFlag(NodeStatus.Offline))
                {
                    <div class="status error inherited">
                        <div class="status-dot"></div>
                        <span>@(DeviceTreeTooltip.InheritedStatusOffline)</span>
                    </div>
                }

                @if (inheritedStatus.HasFlag(NodeStatus.NotSupported))
                {
                    <div class="status warning inherited">
                        <div class="status-dot"></div>
                        <span>@(DeviceTreeTooltip.InheritedStatusNotSupported)</span>
                    </div>
                }

                @if (inheritedStatus.HasFlag(NodeStatus.Unknown))
                {
                    <div class="status warning inherited">
                        <div class="status-dot"></div>
                        <span>@(DeviceTreeTooltip.InheritedStatusUnknown)</span>
                    </div>
                }

                @if (inheritedStatus.HasFlag(NodeStatus.New))
                {
                    <div class="status info inherited">
                        <div class="status-dot"></div>
                        <span>@(DeviceTreeTooltip.InheritedStatusNewlyCreated)</span>
                    </div>
                }
            }
        </div>
    }
</div>
