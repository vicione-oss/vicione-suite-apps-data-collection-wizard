@using DataCollectionWizard.Client.Components.Localization

@{
    var sections = BuildSections();
    var statusFlags = GetStatusFlags();
    var hasImage = !string.IsNullOrWhiteSpace(_deviceImageDataBase64);
    var subtitle = Subtitle;

    // When there is an image, its companion fields (the first key/value section) sit next to it in a hero row; the
    // remaining sections run full width below. Without an image everything is a single full-width column.
    var heroSection = hasImage ? sections.FirstOrDefault(section => section.Kind == TooltipSectionKind.KeyValues) : null;
    var bodySections = heroSection is null ? sections : sections.Where(section => section != heroSection).ToList();

    var isEmpty = sections.Count == 0 && !hasImage && statusFlags.Count == 0;

    RenderFragment<TooltipSection> renderSection = section =>
        @<div class="grp">
            @if (!string.IsNullOrEmpty(section.Label))
            {
                <div class="grp-lbl">@section.Label</div>
            }

            @switch (section.Kind)
            {
                case TooltipSectionKind.Description:
                    <div class="tt-desc">@section.Text</div>
                    break;

                case TooltipSectionKind.Path:
                    <div class="tt-path">@section.Text</div>
                    break;

                case TooltipSectionKind.KeyValues:
                    <div class="kvs">
                        @foreach (var row in section.Rows)
                        {
                            <div class="kv">
                                <span class="k">@row.Label</span>
                                <span class="v">@row.Value</span>
                            </div>
                        }
                    </div>
                    break;

                default:
                    <dl class="rows">
                        @foreach (var row in section.Rows)
                        {
                            <dt>@row.Label</dt>
                            <dd>@row.Value</dd>
                        }
                    </dl>
                    break;
            }
        </div>;
}

<div class="tt @TopStateClass">
    <div class="tt-top">
        <div class="tt-nameline">
            <span class="tt-name">@Device.Name</span>
            @if (RequiresAuthentication)
            {
                <span class="tt-auth-lock">
                    <MonochromeIcon Name="@MonochromeIconName.LockActive" Size="@MonochromeIconSize.Small" />
                </span>
                <span class="tt-auth-badge">Auth</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(subtitle))
        {
            <div class="tt-sub">@subtitle</div>
        }
    </div>

    @if (hasImage)
    {
        <div class="tt-hero">
            <div class="tt-img">
                <img src="data:image/jpeg;base64,@(_deviceImageDataBase64)" alt="" />
            </div>
            @if (heroSection is not null)
            {
                <div class="tt-ids">
                    @foreach (var row in heroSection.Rows)
                    {
                        <div class="kv">
                            <span class="k">@row.Label</span>
                            <span class="v">@row.Value</span>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (bodySections.Count > 0 || isEmpty)
    {
        <div class="tt-body">
            @if (isEmpty)
            {
                <div class="tt-empty">@DeviceTreeTooltip.NoFurtherInformation</div>
            }

            @foreach (var section in bodySections)
            {
                @renderSection(section)
            }
        </div>
    }

    @if (statusFlags.Count > 0)
    {
        <div class="tt-flags">
            @foreach (var (text, severity) in statusFlags)
            {
                <span class="flag @severity"><span class="d"></span>@text</span>
            }
        </div>
    }
</div>
