@using ViciOne.Driver.IoTCore.Contracts.DeviceTree
@using ViciOne.Ui.TreeEditor.Builder.Interface.NodeActions
@using ViciOne.Ui.TreeEditor.Components
@using ViciOne.Ui.TreeEditor.Templates
@using ViciOne.Ui.TreeEditor.Templates.Fragments.Node

@inherits NodeTemplate

<TooltipContainer>
    <ChildContent>
        <div @onpointerenter="@(context.OnPointerEnter)"
             @onpointerleave="@(context.OnPointerLeave)"
             @onpointermove="@(context.OnPointerMove)"
             class="node-template-container">

            @base.Fragment(_contentFragment)
        </div>
    </ChildContent>

    <TooltipContent>
        <DeviceTreeNodeTooltip Device="@(DeviceNode.Device)" IsLiveView="@(DeviceNode.IsLiveView)" InheritedStatus="@((int)DeviceNode.InheritedStatus)" />
    </TooltipContent>
</TooltipContainer>

@code {
    private RenderFragment _contentFragment => __builder =>
    {
        var hasAdditionalStatus = DeviceNode.Status > 0 || DeviceNode.InheritedStatus > 0;
        var hasSubtitle = !string.IsNullOrEmpty(DeviceNode.Subtitle);

        <div @onpointerenter:stopPropagation
             @onpointerleave:stopPropagation
             @onpointermove:stopPropagation
             class="icon-container"
             style="--icon-count: @(Node.Icons.Count());">

            @if (hasAdditionalStatus)
            {
                var hasError = DeviceNode.HasError();
                var hasInheritedError = DeviceNode.HasInheritedError();
                var hasWarning = DeviceNode.HasWarning();
                var hasInheritedWarning = DeviceNode.HasInheritedWarning();
                var isNew = DeviceNode.IsNew();
                var isInheritedNew = DeviceNode.IsInheritedNew();

                var topClass = hasError ? "error" : hasInheritedError ? "error inherited" : "hidden";
                var centerClass = hasWarning ? "warning" : hasInheritedWarning ? "warning inherited" : "hidden";
                var bottomClass = isNew ? "new" : isInheritedNew ? "new inherited" : "hidden";

                <div class="status-bracket">
                    @((MarkupString)string.Format(SvgIcons.status_bracket, topClass, centerClass, bottomClass))
                </div>
            }

            @{
                var iconCount = 0;
                foreach (var icon in Node.Icons)
                {
                    var cssClasses = new List<string> { "icon" };

                    if (string.IsNullOrWhiteSpace(icon.MarkupString))
                    {
                        cssClasses.AddRange(icon.CssClasses.Where(x => !string.IsNullOrWhiteSpace(x)));
                    }

                    <div class="@string.Join(" ", cssClasses)"
                         style="--icon-index: @(++iconCount)">

                        @((MarkupString)icon.MarkupString)
                    </div>
                }
            }
        </div>

        <div class="node-text @(hasSubtitle ? "with-subtitle" : string.Empty)">
            <span>@(DeviceNode.DisplayText)</span>

            @if (hasSubtitle)
            {
                <span class="subtitle">
                    @(DeviceNode.Subtitle)
                </span>
            }
        </div>

        @(ActionButton.Fragment(_actionButtonContainerParameters!))

        @(DropArea.Fragment(_dropAreaParameters!))
    };
}
