@using DataCollectionWizard.Client.Components.LiveGrid.GridCells
@using DataCollectionWizard.Client.Extensions

<div @ref="@(_mainContainerRef)"
     class="live-view-grid">

    <table cellpadding="0"
           cellspacing="0">

        <thead>
            <tr>
                @if (Service.PathVisible)
                {
                    <th class="device-path">
                        <div class="header-template">
                            <span></span>
                            <div>
                                <span>@Localization.LiveViewPage.Path</span>
                            </div>
                        </div>
                    </th>

                    <th class="spacer"
                        style="--spacer-width: 3;">

                        <!-- spacer column -->
                        <div class="header-template">
                            <span></span>
                            <div>&nbsp;</div>
                        </div>
                    </th>
                }

                <th class="device-name">
                    <div class="header-template">
                        <span></span>
                        <div>
                            <span>@Localization.LiveViewPage.ProcessValue</span>
                        </div>
                    </div>
                </th>

                @* <th class="spacer"
                    style="--spacer-width: 12;">

                    <!-- spacer column -->
                    <div class="header-template">
                        <span></span>
                        <div>&nbsp;</div>
                    </div>
                </th> *@

                <th class="value">
                    <div class="header-template">
                        <span></span>
                        <div>@Localization.LiveViewPage.Value</div>
                    </div>
                </th>

                <th class="unit">
                    <div class="header-template">
                        <span></span>
                        <div>@Localization.LiveViewPage.Unit</div>
                    </div>
                </th>

                <th class="last-changed">
                    <div class="header-template" title=" @(Localization.LiveViewPage.LastChangedHint)">
                        <span></span>
                        <div>@Localization.LiveViewPage.LastChanged <span class="icon-header"><MonochromeIcon Name="@MonochromeIconName.WarningLight" Size="@MonochromeIconSize.SmallMedium" /></span></div>
                    </div>
                </th>

                <th class="spacer absorbtion">
                    <!-- space absorbtion column -->
                    <div class="header-template">
                        <span></span>
                        <div>&nbsp;</div>
                    </div>
                </th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Service.FilteredGridItems)
            {
                <tr>
                    @if (Service.PathVisible)
                    {
                        <td class="device-path"
                            title="@(item.PathToNode.GetBreadcrumb())">

                            <div class="device-path-container">
                                <span>@(item.PathToNode.GetBreadcrumb())</span>
                            </div>
                        </td>

                        const int spacerWidth = 3;

                        <td class="spacer"
                            style="--spacer-width: @(spacerWidth);">

                            <!-- spacer column -->
                        </td>
                    }

                    <td class="device-name"
                        title="@(item.DataNode.Name)">

                        <DeviceIdentifierCell Model="item" />
                    </td>

                    @* @{ spacerWidth = 12; }

                    <td class="spacer"
                        style="--spacer-width: @(spacerWidth);">

                        <!-- spacer column -->
                    </td> *@

                    <td class="value">
                        <span>@item.Value</span>
                    </td>

                    <td class="unit">
                        <span>@item.Unit</span>
                    </td>

                    <td class="last-changed">
                        <span>@item.LastUpdated</span>
                    </td>

                    <td class="spacer absorbtion">
                        <!-- space absorbtion column -->
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
