@using DataCollectionWizard.Client.Components.LiveGrid.GridCells
@using DataCollectionWizard.Client.Components.LiveGrid.Models
@using DataCollectionWizard.Client.Models
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using ViciOne.Ui.Localization.Resources

@* Built like the configuration grid - same subgrid layout, sticky header, grouping and virtualization - only
   without its selection column, since there is nothing to act on here. *@
<div @ref="@(_mainContainerRef)"
     class="live-view-grid"
     style="--grid-columns: @GridColumnsStyle">

    @* --- HEADER --- *@
    <div class="grid-header">
        <div class="device-name">
            <div class="header-template">
                <span></span>
                <div>
                    <span>@Localization.LiveViewPage.ProcessValue</span>
                </div>
            </div>
        </div>

        <div class="value">
            <div class="header-template">
                <span></span>
                <div>@CommonVocabulary.Value</div>
            </div>
        </div>

        <div class="unit">
            <div class="header-template">
                <span></span>
                <div>@Localization.LiveViewPage.Unit</div>
            </div>
        </div>

        <div class="last-changed">
            <div class="header-template" title="@(Localization.LiveViewPage.LastChangedHint)">
                <span></span>
                <div>
                    @Localization.LiveViewPage.LastChanged
                    <span class="icon-header">
                        <MonochromeIcon Name="@MonochromeIconName.WarningLight" Size="@MonochromeIconSize.SmallMedium" />
                    </span>
                </div>
            </div>
        </div>

        <div class="spacer absorbtion">
            <!-- space absorption column -->
            <div class="header-template">
                <span></span>
                <div>&nbsp;</div>
            </div>
        </div>
    </div>

    @* --- BODY (virtualized) --- *@
    <div class="grid-body">
        <Virtualize @ref="_virtualizeRef"
                    TItem="IndexedItem<GroupedRow<LiveGridRowModel>>"
                    Items="@_indexedItems"
                    Context="entry"
                    ItemSize="48"
                    OverscanCount="10">

            @{
                var row = entry.Item;
            }

            @if (row.IsHeader)
            {
                <div class="grid-group-row" @key="(row.IsHeader, entry.Index)">
                    <div class="grid-group-header">
                        <span class="grid-group-label">@row.GroupLabel</span>
                        <span class="grid-group-count">· @row.GroupItems!.Count</span>
                    </div>
                </div>
            }
            else
            {
                var item = row.Item!;

                <div class="grid-row @(row.IsEvenDataRow ? "row-even" : "row-odd")" @key="(row.IsHeader, entry.Index)">
                    <div class="device-name" title="@(item.DataNode.Name)">
                        @* Grouped rows only need the part below their header; an ungrouped row carries its
                           full path. Same rule as in the configuration grid. *@
                        <DeviceIdentifierCell Context="@(row.IsGrouped ? row.GroupRelativePath : item.Breadcrumb)"
                                              Model="item" />
                    </div>

                    <div class="value" title="@item.Value">
                        <span>@item.Value</span>
                    </div>

                    <div class="unit">
                        <span>@item.Unit</span>
                    </div>

                    <div class="last-changed">
                        <span>@item.LastUpdated</span>
                    </div>

                    <div class="spacer absorbtion">
                        <!-- space absorption column -->
                    </div>
                </div>
            }
        </Virtualize>
    </div>
</div>
