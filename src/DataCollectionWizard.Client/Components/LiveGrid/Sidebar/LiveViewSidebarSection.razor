@using DataCollectionWizard.Client.Services
@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.Localization.Resources

<div class="live-view-section-container">
    <div class="tree-options">
        <SearchBox Placeholder="@CommonVocabulary.Search"
                   Text="@_filterText"
                   TextChanging="@OnFilterTextChanging" />

        <Button Enabled="@Service.TreeBuilder.Selection.SelectedNodes.Any()"
                IconCssClass="@s_expandIconCssClass"
                OnClick="@OnExpandTreeButtonClick"
                Title="@Localization.DataCollectionWizardPage.Expand" />

        <Button Enabled="@Service.TreeBuilder.Selection.SelectedNodes.Any()"
                IconCssClass="@s_collapseIconCssClass"
                OnClick="@OnCollapseTreeButtonClick"
                Title="@Localization.DataCollectionWizardPage.Collapse" />
    </div>
    
    <TreeEditor Builder="@Service.TreeBuilder" />
</div>
