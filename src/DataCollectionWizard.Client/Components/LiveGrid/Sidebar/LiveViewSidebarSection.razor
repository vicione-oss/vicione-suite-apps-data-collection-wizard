@using DataCollectionWizard.Client.Services
@using ViciOne.Ui.Shared.Dx.Components

<div class="live-view-section-container">
    <SearchBox TextChanged="@OnFilterTextChanged">
        <SearchBoxButton Action="@(() => OnChangeTreeExpansionClicked(true))"
                         Enabled="@(Service.TreeBuilder.Selection.SelectedNodes.Any())"
                         Icon="@(SvgIcons.expand)"
                         Tooltip="@Localization.DataCollectionWizardPage.Expand" />

        <SearchBoxButton Action="@(() => OnChangeTreeExpansionClicked(false))"
                         Enabled="@(Service.TreeBuilder.Selection.SelectedNodes.Any())"
                         Icon="@(SvgIcons.collapse)"
                         Tooltip="@Localization.DataCollectionWizardPage.Collapse" />
    </SearchBox>
    
    <TreeEditor Builder="@(Service.TreeBuilder)" />
</div>
