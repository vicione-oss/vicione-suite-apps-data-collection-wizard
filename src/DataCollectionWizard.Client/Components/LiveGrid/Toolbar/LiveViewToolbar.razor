@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.Localization.Resources

<div class="toolbar-container">
    <span class="header">
        @Localization.LiveViewPage.LiveView
    </span>

    <div class="searchbox-container">
        <SearchBox @bind-Text="SearchText"
                   @bind-Text:event="TextChanging"
                   Placeholder="@CommonVocabulary.Search" />
    </div>

    <div class="toolbar">
        <span class="separator"></span>

        <button @onclick="@(OnTogglePathVisible)"
                class="@(Service.PathVisible ? "active" : string.Empty)"
                title="@Localization.LiveViewPage.PathVisible">

            <MonochromeIcon Name="@MonochromeIconName.PathDetailsShow" Size="@MonochromeIconSize.SmallMedium" />
        </button>

        <span class="separator"></span>

        <button @onclick="@OnRefresh"
                title="@Localization.LiveViewPage.Rescan">

            <MonochromeIcon Name="@MonochromeIconName.Refresh" Size="@MonochromeIconSize.SmallMedium" />
        </button>
    </div>
</div>
