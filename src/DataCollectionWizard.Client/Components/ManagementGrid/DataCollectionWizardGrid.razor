@using DataCollectionWizard.Client.Components.ManagementGrid.GridCells
@using DataCollectionWizard.Client.Components.ManagementGrid.Models
@using DataCollectionWizard.Client.Extensions
@using DataCollectionWizard.Client.Models
@using DataCollectionWizard.Public.Extensions
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using ViciOne.Driver.IoTCore.Contracts.DeviceTree

<div @ref="@(_mainContainerRef)"
     class="data-collection-wizard-grid"
     style="--grid-columns: @GridColumnsStyle">

    @* --- HEADER --- *@
    <div class="grid-header">
        @if (Service.PathVisible)
        {
            <div class="device-path">
                <div class="header-template">
                    <span></span>
                    <div>
                        <span>@Localization.DataCollectionWizardPage.Path</span>
                    </div>
                </div>
            </div>

            <div class="spacer">
                <!-- spacer column -->
                <div class="header-template">
                    <span></span>
                    <div>&nbsp;</div>
                </div>
            </div>
        }

        <div class="device-name">
            <div class="header-template">
                <span></span>
                <div>
                    <span>@Localization.DataCollectionWizardPage.ProcessValue</span>
                </div>
            </div>
        </div>

        @for (var hi = 0; hi < PublishTargetInfos.Count; hi++)
        {
            var targetInfo = PublishTargetInfos[hi];

            <div class="publish-target">
                <div class="header-template">
                    <span>@(targetInfo.Connection.Name)</span>

                    <div class="publish-target">
                        <span>
                            @Localization.DataCollectionWizardPage.Enabled
                        </span>

                        <span>
                            @Localization.DataCollectionWizardPage.Details
                        </span>
                    </div>
                </div>
            </div>

            if (hi < PublishTargetInfos.Count - 1)
            {
                <div class="spacer publish-target">
                    <!-- spacer column -->
                    <div class="header-template">
                        <span></span>
                        <div>&nbsp;</div>
                    </div>
                </div>
            }
        }

        <div class="spacer absorbtion">
            <!-- space absorption column -->
            <div class="header-template">
                <span></span>
                <div>&nbsp;</div>
            </div>
        </div>
    </div>

    @* --- BODY (virtualized) --- *@
    <div class="grid-body">
        <Virtualize @ref="_virtualizeRef"
                    TItem="IndexedItem<ManagementGridRowModel>"
                    Items="@_indexedItems"
                    Context="entry"
                    ItemSize="48"
                    OverscanCount="10">

            <div class="grid-row @(entry.Index % 2 == 0 ? "row-even" : "row-odd")">
                @{
                    var item = entry.Item;
                }

                @if (Service.PathVisible)
                {
                    <div class="device-path"
                         title="@(item.Breadcrumb)">

                        <div class="device-path-container">
                            <span>@(item.Breadcrumb)</span>
                        </div>
                    </div>

                    <div class="spacer">
                        <!-- spacer column -->
                    </div>
                }

                <div class="device-name">
                    <DeviceIdentifierCell AllNodes="@AllNodes"
                                          ExpandedChanged="@(RefreshAsync)"
                                          Model="item"
                                          PublishTargetInfos="@PublishTargetInfos" />
                </div>

                @for (var ci = 0; ci < PublishTargetInfos.Count; ci++)
                {
                    var targetInfo = PublishTargetInfos[ci];

                    <div class="publish-target"
                         title="@(targetInfo.IsSupported ? string.Empty : Localization.DataCollectionWizardPage.MoneoDeactivatedTooltip)">

                        <div class="publish-target-cell-wrapper @(item.DataNode.HasCaptions() ? "captioned" : string.Empty)"
                             style="--caption-count: @(item.DataNode.CaptionCount())">

                            @{
                                var masterNode = item.PathToNode.ElementAt(1) as IDeviceTreeMasterNode;

                                if (item.DataNode is IDeviceTreeConfigurableRawDataNode configurableBlobData)
                                {
                                    <ConfigurableRawDataCell ConfigurableRawDataNode="@configurableBlobData"
                                                             Configuration="@targetInfo"
                                                             MaxTimesADay="@RawDataPullingMaxTimesADay"
                                                             OnDeviceTreeChanged="@(() => OnDeviceTreeChanged.InvokeAsync(masterNode))" />
                                }

                                if (item.DataNode is IDeviceTreeSchedulableDataNode blobData)
                                {
                                    <BlobDataCell BlobDataNode="@blobData"
                                                  Configuration="@targetInfo"
                                                  DownloadButtonClicked="@(async args => await OnBlobDataDownloadButtonClick.InvokeAsync(args))"
                                                  MaxTimesADay="@RawDataPullingMaxTimesADay"
                                                  OnDeviceTreeChanged="@(() => OnDeviceTreeChanged.InvokeAsync(masterNode))" />
                                }

                                if (item.DataNode is IDeviceTreeEventTriggerDataNode rawData)
                                {
                                    <RawDataCell IsExpanded="@item.IsExpanded"
                                                 MaxTimesADay="@RawDataPullingMaxTimesADay"
                                                 OnDeviceTreeChanged="@(() => OnDeviceTreeChanged.InvokeAsync(masterNode))"
                                                 Configuration="@targetInfo"
                                                 RawDataNode="@rawData" />
                                }

                                if (item.DataNode is IDeviceTreeCompressableDataNode dataNode && dataNode.DataType.SupportedForLogging())
                                {
                                    if (dataNode.DataType.SupportedForCompression())
                                    {
                                        <CompressableCell CompressableDataNode="@dataNode"
                                                          Configuration="@targetInfo"
                                                          OnDeviceTreeChanged="@(() => OnDeviceTreeChanged.InvokeAsync(masterNode))" />
                                    }
                                    else
                                    {
                                        <UncompressableCell CompressableDataNode="@dataNode"
                                                            Configuration="@targetInfo"
                                                            OnDeviceTreeChanged="@(() => OnDeviceTreeChanged.InvokeAsync(masterNode))" />
                                    }
                                }
                            }
                        </div>
                    </div>

                    if (ci < PublishTargetInfos.Count - 1)
                    {
                        <div class="spacer">
                            <!-- spacer column -->
                        </div>
                    }
                }

                <div class="spacer absorbtion">
                    <!-- space absorption column -->
                </div>
            </div>
        </Virtualize>
    </div>
</div>
