@using System.Drawing
@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.Localization.Resources

<div @onclick="@OnContainerClicked"
     class="device-tree-section-container">
     
    <div class="tree-options">
        <SearchBox Placeholder="@CommonVocabulary.Search"
                   Text="@_filterText"
                   TextChanging="@OnFilterTextChanging" />

        <Button Enabled="@(!Service.DisableClusterActions)"
                IconCssClass="@_plusIconCssClass"
                OnClick="@OnAddNewDeviceButtonClick"
                Title="@Localization.DataCollectionWizardPage.AddNewDevice" />

        <Button Enabled="@Service.TreeBuilder.Selection.SelectedNodes.Any()"
                IconCssClass="@_expandIconCssClass"
                OnClick="@OnExpandTreeButtonClick"
                Title="@Localization.DataCollectionWizardPage.Expand" />

        <Button Enabled="@Service.TreeBuilder.Selection.SelectedNodes.Any()"
                IconCssClass="@_collapseIconCssClass"
                OnClick="@OnCollapseTreeButtonClick"
                Title="@Localization.DataCollectionWizardPage.Collapse" />
    </div>
    
    <TreeEditor Builder="@(Service.TreeBuilder)" />
</div>

@* Todo: use context menu *@
@if (_addDeviceMenuRootPosition != Point.Empty)
{
    <div @onpointerleave="@OnAddDeviceMenuPointerLeave"
         class="add-device-menu"
         style="--position-x: @(_addDeviceMenuRootPosition.X)px; --position-y: @(_addDeviceMenuRootPosition.Y)px">

        <div @onclick="@OnAddIoLinkMasterClicked"
             class="menu-entry">

            <MonochromeIcon Name="@MonochromeIconName.PlusSlim" Size="@MonochromeIconSize.SmallMedium" />

            <div>@Localization.DataCollectionWizardPage.IoLinkMasterName</div>
        </div>

        <div @onclick="@OnAddVseClicked"
             class="menu-entry">

            <MonochromeIcon Name="@MonochromeIconName.PlusSlim" Size="@MonochromeIconSize.SmallMedium" />

            <div>@Localization.DataCollectionWizardPage.VseName</div>
        </div>

    </div>
}
