<div class="configurable-raw-data-cell">

    <!-- placeholder -->
    <div></div>

    <ComboBox Enabled="@(IsSupportedConnection())"
              Items="@(_frequencies)"
              TextSelector="@(e => e.Text)"
              TItem="@(ComboBoxOption<int>)"
              TValue="@(int)"
              Value="@(GetSelectedFrequency())"
              ValueChanged="@(FrequencyChanged)"
              ValueSelector="@(e => e.Value)"/>

    <ComboBox Enabled="@(IsSupportedConnection())"
              Items="@(_durations)"
              TextSelector="@(e => e.Text)"
              TItem="@(ComboBoxOption<int>)"
              TValue="@(int)"
              Value="@(GetSelectedDuration())"
              ValueChanged="@(DurationChanged)"
              ValueSelector="@(e => e.Value)"/>
</div>
