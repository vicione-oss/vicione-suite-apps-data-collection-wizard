@using DataCollectionWizard.Internal.Contracts
@using ViciOne.DeviceTree.Contracts

<div class="compressable-cell">
    <Switch Enabled="@(IsSupportedConnection())"
            Value="@(IsCompressionEnabled())"
            ValueChanged="@(CompressionEnabledChanged)" />

    <ComboBox Enabled="@(IsSupportedConnection())"
              Items="@(PoolingGrids)"
              TextSelector="@(s_poolingGridTextSelector)"
              TItem="@(ComboBoxOption<PoolingGrid>)"
              TValue="@(PoolingGrid)"
              Value="@(GetSelectedPoolingGrid())"
              ValueChanged="@(PoolingGridChanged)"
              ValueSelector="@(s_poolingGridValueSelector)" />

    <ComboBox Enabled="@(!IsOnChange() && IsSupportedConnection())"
              Items="@(AggregationFunctions)"
              TextSelector="@(s_aggregationFunctionTextSelector)"
              TItem="@(ComboBoxOption<AggregationFunction>)"
              TValue="@(AggregationFunction)"
              Value="@(GetSelectedAggregationFunction())"
              ValueChanged="@(AggregationFunctionChanged)"
              ValueSelector="@(s_aggregationFunctionValueSelector)" />
</div>
