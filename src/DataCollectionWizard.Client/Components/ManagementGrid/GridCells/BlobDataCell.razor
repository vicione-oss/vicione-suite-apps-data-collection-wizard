@using DataCollectionWizard.Client.Extensions

<div class="blob-data-cell">
    <Switch Enabled="@(IsSupportedConnection())"
            Value="@(IsRecordingEnabled())"
            ValueChanged="@(SchedulingEnabledChanged)" />

    <ComboBox Enabled="@(IsSupportedConnection())"
              Items="@(_daysOfWeek)"
              TextSelector="@(s_daysOfWeekTextSelector)"
              TItem="@(ComboBoxOption<DaysOfWeek>)"
              TValue="@(DaysOfWeek)"
              Value="@(GetSelectedDaysOfWeek())"
              ValueChanged="@(OnDaysOfWeekChanged)"
              ValueSelector="@(s_daysOfWeekValueSelector)" />

    <ComboBox Enabled="@(IsSupportedConnection())"
              Items="@(_timesADay)"
              TextSelector="@(s_timesADayTextSelector)"
              TItem="@(ComboBoxOption<int>)"
              TValue="@(int)"
              Value="@(GetTimesADay())"
              ValueChanged="@(OnTimesADayChanged)"
              ValueSelector="@(s_timesADayValueSelector)" />
</div>
